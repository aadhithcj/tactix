# Postgres with pgvector. postgres:// URLs from Supabase or Render are accepted as-is.
DATABASE_URL=postgresql+psycopg://tactix:tactix_pass@localhost:5432/tactix_db

# Optional: enables Gemini for the Pundit's Take, reading custom plans and Analyst Q&A.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated exact origins allowed to call the API (add your production site).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Extra origins by regex, e.g. Vercel preview deployments.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Fetch the curated moments in the background when the database is empty.
AUTO_SEED=true
ENVIRONMENT=development
